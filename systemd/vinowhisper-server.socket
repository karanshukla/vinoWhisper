; Reference copy — see vinowhisper-server.service. The socket unit is the one
; to enable (`systemctl --user enable --now vinowhisper-server.socket`): it
; owns the port with no process behind it, and systemd spawns the service on
; the first connection.

[Unit]
Description=vinoWhisper transcription server socket
Documentation=https://github.com/karanshukla/vinoWhisper

[Socket]
; A Unix socket in the runtime dir (%t is $XDG_RUNTIME_DIR), readable and
; writable by you alone. A localhost TCP port could be bound or reached by any
; local user.
ListenStream=%t/vinowhisper/server.sock
SocketMode=0600
DirectoryMode=0700
Accept=no

[Install]
WantedBy=sockets.target
