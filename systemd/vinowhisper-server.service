; Reference copy. `vinowhisper-setup` generates this file against the paths
; that actually exist on your machine and writes it to
; ~/.config/systemd/user/ — use that unless you have a reason not to.
; `vinowhisper-setup --print-units` shows exactly what it would write.
;
; If you install this by hand, ExecStart below has to point at the
; vinowhisper-server entry point inside your environment. The %h/Development
; path is a placeholder, not a default that works anywhere.

[Unit]
Description=vinoWhisper transcription server
Documentation=https://github.com/karanshukla/vinoWhisper
Requires=vinowhisper-server.socket

[Service]
ExecStart=%h/Development/vinoWhisper/.venv/bin/vinowhisper-server --device auto
Restart=on-failure
RestartSec=2

; No [Install]/WantedBy: this unit is socket-activated (see
; vinowhisper-server.socket), not enabled/started directly. Systemd starts it
; on the first connection and it self-exits after config.IDLE_TIMEOUT_S idle;
; that plain (exit code 0) exit is not a "failure", Restart=on-failure only
; covers real crashes.
